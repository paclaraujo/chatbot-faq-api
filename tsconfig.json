{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "generated/prisma/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/test-utils/**"]
}