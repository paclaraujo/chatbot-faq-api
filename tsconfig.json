{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "generated/prisma/**/*.ts"]
}