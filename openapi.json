{
  "openapi": "3.0.3",
  "info": {
    "title": "Chatbot de FAQ com Dashboard Analítico - API",
    "description": "API para consulta de perguntas frequentes via chatbot e acompanhamento de métricas de utilização em um dashboard analítico.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Ambiente local"
    }
  ],
  "tags": [
    { "name": "Health", "description": "Status da aplicação" },
    { "name": "Auth", "description": "Autenticação" },
    { "name": "FAQ", "description": "Cadastro de perguntas e respostas (requer autenticação)" },
    { "name": "Chat", "description": "Consulta ao chatbot e histórico de interações" },
    { "name": "Analytics", "description": "Métricas e indicadores do dashboard (requer autenticação)" }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Autentica um usuário e retorna um token JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginInput" },
              "example": {
                "email": "admin@hello-prisma.com",
                "password": "changeme123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": {
            "description": "Email ou senha não informados",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": ["Health"],
        "summary": "Verifica se a API está no ar",
        "responses": {
          "200": {
            "description": "API operando normalmente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthStatus" }
              }
            }
          }
        }
      }
    },
    "/faq": {
      "get": {
        "tags": ["FAQ"],
        "summary": "Lista todas as FAQs cadastradas",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de FAQs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Faq" }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["FAQ"],
        "summary": "Cadastra uma nova FAQ",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateFaqInput" },
              "example": {
                "question": "Como faço para redefinir minha senha?",
                "answer": "Acesse Configurações > Segurança > Redefinir senha.",
                "category": "conta"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "FAQ criada com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Faq" }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/faq/{id}": {
      "patch": {
        "tags": ["FAQ"],
        "summary": "Atualiza uma FAQ existente",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateFaqInput" },
              "example": { "answer": "Nova resposta atualizada." }
            }
          }
        },
        "responses": {
          "200": {
            "description": "FAQ atualizada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Faq" }
              }
            }
          },
          "400": {
            "description": "FAQ não encontrada ou dados inválidos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["FAQ"],
        "summary": "Remove uma FAQ",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "204": { "description": "FAQ removida com sucesso" },
          "400": {
            "description": "FAQ não encontrada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "tags": ["Chat"],
        "summary": "Envia uma pergunta ao chatbot",
        "description": "Busca a FAQ mais semelhante à pergunta enviada (busca por similaridade de texto) e registra a interação no histórico.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AskQuestionInput" },
              "example": { "question": "como redefino minha senha" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resposta do chatbot",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatAnswer" },
                "examples": {
                  "match encontrado": {
                    "value": {
                      "matched": true,
                      "answer": "Acesse Configurações > Segurança > Redefinir senha.",
                      "faq": {
                        "id": 5,
                        "question": "Como faço para redefinir minha senha?",
                        "category": "conta"
                      }
                    }
                  },
                  "sem resposta": {
                    "value": {
                      "matched": false,
                      "answer": null,
                      "message": "Não encontramos uma resposta para essa pergunta. Tente reformulá-la ou entre em contato com o suporte."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Pergunta não informada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/chat/history": {
      "get": {
        "tags": ["Chat"],
        "summary": "Lista o histórico de interações do chatbot",
        "responses": {
          "200": {
            "description": "Histórico de interações, mais recentes primeiro",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Interaction" }
                }
              }
            }
          }
        }
      }
    },
    "/analytics": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Indicadores do dashboard analítico",
        "description": "Retorna totais de consultas, perguntas mais frequentes, perguntas sem resposta, distribuição por categoria e evolução temporal.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "topLimit",
            "in": "query",
            "description": "Quantidade máxima de perguntas mais frequentes retornadas",
            "schema": { "type": "integer", "default": 5 }
          },
          {
            "name": "unansweredLimit",
            "in": "query",
            "description": "Quantidade máxima de perguntas sem resposta retornadas",
            "schema": { "type": "integer", "default": 5 }
          },
          {
            "name": "timelineDays",
            "in": "query",
            "description": "Janela em dias considerada na evolução temporal",
            "schema": { "type": "integer", "default": 30 }
          }
        ],
        "responses": {
          "200": {
            "description": "Indicadores calculados com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnalyticsDashboard" }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token obtido em POST /auth/login. Envie como 'Authorization: Bearer <token>'."
      }
    },
    "schemas": {
      "LoginInput": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
        }
      },
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "uptime": { "type": "number", "example": 12.345 }
        }
      },
      "Faq": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "question": { "type": "string", "example": "Como faço para redefinir minha senha?" },
          "answer": { "type": "string", "example": "Acesse Configurações > Segurança > Redefinir senha." },
          "category": { "type": "string", "example": "conta" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateFaqInput": {
        "type": "object",
        "required": ["question", "answer", "category"],
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" },
          "category": { "type": "string" }
        }
      },
      "UpdateFaqInput": {
        "type": "object",
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" },
          "category": { "type": "string" }
        }
      },
      "AskQuestionInput": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "question": { "type": "string", "example": "como redefino minha senha" }
        }
      },
      "ChatAnswer": {
        "type": "object",
        "properties": {
          "matched": { "type": "boolean" },
          "answer": { "type": "string", "nullable": true },
          "message": { "type": "string", "description": "Presente apenas quando matched é false" },
          "faq": {
            "type": "object",
            "description": "Presente apenas quando matched é true",
            "properties": {
              "id": { "type": "integer" },
              "question": { "type": "string" },
              "category": { "type": "string" }
            }
          }
        }
      },
      "Interaction": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "question": { "type": "string" },
          "matched": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "faqId": { "type": "integer", "nullable": true },
          "faq": {
            "allOf": [{ "$ref": "#/components/schemas/Faq" }],
            "nullable": true
          }
        }
      },
      "AnalyticsDashboard": {
        "type": "object",
        "properties": {
          "totalInteractions": { "type": "integer", "example": 42 },
          "totalMatched": { "type": "integer", "example": 30 },
          "totalUnmatched": { "type": "integer", "example": 12 },
          "matchRate": { "type": "number", "example": 0.714 },
          "topQuestions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "faqId": { "type": "integer" },
                "question": { "type": "string" },
                "category": { "type": "string" },
                "count": { "type": "integer" }
              }
            }
          },
          "unanswered": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question": { "type": "string" },
                "count": { "type": "integer" },
                "lastAskedAt": { "type": "string", "format": "date-time" }
              }
            }
          },
          "byCategory": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category": { "type": "string" },
                "count": { "type": "integer" }
              }
            }
          },
          "timeline": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": { "type": "string", "format": "date-time" },
                "count": { "type": "integer" }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Question is required" }
        }
      }
    }
  }
}
